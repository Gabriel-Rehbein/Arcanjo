# Configuração do banco de dados PostgreSQL / Supabase
# Para Supabase, use DATABASE_URL e DB_SSL=true.
DATABASE_URL=postgres://user:password@host:5432/database
DB_SSL=false

DB_USER=postgres
DB_PASSWORD=senacrs
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcanjo

# Frontend autorizado para CORS
FRONTEND_URL=http://localhost:3001

# JWT e segurança
JWT_SECRET=troca_este_seguro
JWT_EXPIRES_IN=7d

# Opcional: seed de dados automática ao iniciar
RUN_SEED=false
PORT=3000

# Limites por IP. Em desenvolvimento, os defaults internos sao mais permissivos.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
